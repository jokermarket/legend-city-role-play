<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>LEGEND CITY - Role Play</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:Arial,sans-serif}
body{background:#0a0a12;color:#fff;text-align:center;overflow-x:hidden}
header{padding:10px;background:#111} header b{font-size:26px} header b span{color:#ffd700}
#hud{display:flex;justify-content:space-between;padding:10px;background:#222;font-weight:900;font-size:15px}
#hud span{color:#ffd700}
canvas{background:#2d2d2d;display:block;margin:5px auto;border:3px solid #ffd700;max-width:100%}
#msg{background:#ffd700;color:#000;padding:10px;font-weight:800;min-height:36px}
#story{background:#222;margin:8px;padding:12px;border-radius:12px;text-align:left;font-size:14px;line-height:1.5}
#story b{color:#ffd700}
#controls{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;max-width:360px;margin:10px auto;padding:0 10px}
#controls button{background:#333;color:#fff;border:2px solid #555;padding:18px 0;border-radius:14px;font-size:20px;font-weight:900}
#controls button:active{background:#ffd700;color:#000}
#actionBtn{background:#ffd700 !important;color:#000 !important}
#jobs{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin:8px}
#jobs button{background:#222;color:#fff;border:2px solid #ffd700;padding:10px 14px;border-radius:20px;font-weight:900}
#jobs button.active{background:#ffd700;color:#000}
#charSelect{padding:15px}
#charSelect button{font-size:30px;padding:12px;margin:6px;border-radius:14px;background:#222;border:2px solid #555}
#charSelect button.active{border-color:#ffd700;background:#ffd700}
input{padding:12px;border-radius:10px;border:none;width:80%;margin:8px;font-size:16px;text-align:center}
#startBtn{background:#ffd700;color:#000;border:none;padding:14px 30px;border-radius:20px;font-size:18px;font-weight:900;margin:10px}
</style>
</head>
<body>
<header><b>LEGEND <span>CITY</span></b> - ROLE PLAY</header>

<div id="charSelect">
<h2>👤 CREATE YOUR CHARACTER</h2>
<p style="color:#aaa;margin:8px">Type your name, pick your look, pick your life</p>
<input id="playerName" placeholder="Enter your RP Name e.g. Legend Boss" value="Legend Boss">
<p style="margin-top:10px">Pick Your Character:</p>
<button onclick="pickChar('🧍',this)" class="active">🧍</button>
<button onclick="pickChar('🧑‍🎤',this)">🧑‍🎤</button>
<button onclick="pickChar('👮',this)">👮</button>
<button onclick="pickChar('🦹',this)">🦹</button>
<button onclick="pickChar('🧕',this)">🧕</button>
<button onclick="pickChar('👩‍🦰',this)">👩‍🦰</button>
<p style="margin-top:10px">Pick Your Role / Job:</p>
<div id="jobs">
<button onclick="pickJob('GANGSTER','Steal money, avoid police',this)" class="active">🦹 GANGSTER</button>
<button onclick="pickJob('TAXI DRIVER','Carry people, earn money',this)">🚕 TAXI DRIVER</button>
<button onclick="pickJob('POLICE','Catch gangsters',this)">👮 POLICE</button>
<button onclick="pickJob('BUSINESS MAN','Buy shops, become rich',this)">💼 BUSINESS MAN</button>
</div>
<button id="startBtn" onclick="startGame()">▶ START MY LIFE IN LEGEND CITY</button>
<p style="font-size:13px;color:#888">This is Role Play - You decide what to do. Talk, work, drive, make money, become LEGEND.</p>
</div>

<div id="gameArea" style="display:none">
<div id="hud"><div>👤 <span id="hudName">Legend</span></div><div>💰 $<span id="money">0</span></div><div>⭐ <span id="wanted">0</span></div><div>🎭 <span id="hudJob">GANGSTER</span></div></div>
<div id="msg">Welcome to Legend City! Your story don start. Pick money, do your job.</div>
<canvas id="game" width="360" height="420"></canvas>
<div id="story"><b>🎭 YOUR STORY:</b> <span id="storyText">You just arrive Legend City with $0. Everybody dey look you. Prove yourself!</span><br><br><b>🎯 MISSION:</b> <span id="missionText">Pick 3 money bags, do your job, reach $500 to become LEGEND.</span><br><br><b>💬 ROLE PLAY CHAT:</b> <span id="rpChat">People for street: "Who be this new person? Make e show wetin e fit do!"</span></div>
<div id="controls">
<button onclick="move('up')">⬆️</button>
<button onclick="move('down')">⬇️</button>
<button id="actionBtn" onclick="action()">🚗 ENTER CAR</button>
<button onclick="move('left')">⬅️</button>
<button onclick="move('right')">➡️</button>
<button onclick="talk()">💬 TALK</button>
</div>
<div style="display:flex;gap:8px;justify-content:center;margin:10px">
<button onclick="doJob()" style="background:#ffd700;color:#000;border:none;padding:12px 18px;border-radius:20px;font-weight:900">💼 DO MY JOB (+$50)</button>
<button onclick="resetGame()" style="background:#333;color:#fff;border:2px solid #555;padding:12px 18px;border-radius:20px;font-weight:900">🔄 NEW LIFE</button>
</div>
<p style="font-size:13px;color:#888;padding:6px">TALK = talk to people • DO MY JOB = earn money for your role • Drive car to run from police</p>
</div>

<script>
var cv=document.getElementById('game'),ctx=cv.getContext('2d');
var myChar='🧍',myJob='GANGSTER',myJobDesc='Steal money, avoid police',myName='Legend Boss';
var player={x:180,y:350,inCar:false,car:null};
var moneyBag=[{x:60,y:80,taken:false},{x:280,y:120,taken:false},{x:150,y:220,taken:false},{x:300,y:300,taken:false},{x:60,y:300,taken:false},{x:200,y:60,taken:false}];
var cars=[{x:100,y:200,color:'#ff4444',taken:false},{x:250,y:280,color:'#44aaff',taken:false},{x:80,y:350,color:'#ffd700',taken:false}];
var people=[{x:100,y:100,emoji:'👨',say:'Abeg help me! I need taxi!'},{x:260,y:60,emoji:'👩',say:'Legend City no safe o! Police dey everywhere!'},{x:180,y:180,emoji:'🧓',say:'If you want money, go work! No steal!'},{x:50,y:250,emoji:'👦',say:'Oga boss! I want be like you when I grow!'}];
var police=[{x:180,y:80,speed:1.3},{x:320,y:200,speed:1.3}];
var money=0,wanted=0,picked=0,gameOver=false,talks=0;
function pickChar(c,el){myChar=c;document.querySelectorAll('#charSelect button').forEach(b=>b.classList.remove('active'));el.classList.add('active')}
function pickJob(j,d,el){myJob=j;myJobDesc=d;document.querySelectorAll('#jobs button').forEach(b=>b.classList.remove('active'));el.classList.add('active')}
function startGame(){myName=document.getElementById('playerName').value||'Legend Boss';document.getElementById('charSelect').style.display='none';document.getElementById('gameArea').style.display='block';document.getElementById('hudName').innerText=myName;document.getElementById('hudJob').innerText=myJob;document.getElementById('msg').innerText='Welcome '+myName+'! You are now a '+myJob+' for Legend City!';document.getElementById('storyText').innerText=myName+' just arrive Legend City as a '+myJob+'. '+myJobDesc+'. Everybody dey watch you. Make your name big!';draw()}
function draw(){
ctx.fillStyle='#2d2d2d';ctx.fillRect(0,0,360,420);
ctx.fillStyle='#444';ctx.fillRect(0,130,360,30);ctx.fillRect(0,260,360,30);ctx.fillRect(120,0,30,420);ctx.fillRect(240,0,30,420);
ctx.fillStyle='#1e1e2e';ctx.fillRect(10,10,90,90);ctx.fillRect(170,10,50,90);ctx.fillRect(280,10,70,90);ctx.fillRect(10,180,90,60);ctx.fillRect(170,180,50,60);ctx.fillRect(280,180,70,60);ctx.fillRect(10,310,90,90);ctx.fillRect(170,310,50,90);ctx.fillRect(280,310,70,60);
ctx.fillStyle='#fff';ctx.font='11px Arial';ctx.fillText('🏦 BANK',25,55);ctx.fillText('🏪 SHOP',180,55);ctx.fillText('🏠 HOUSE',285,55);ctx.fillText('🏢 OFFICE',180,205);ctx.fillText('🚖 TAXI PARK',25,205);
moneyBag.forEach(m=>{if(!m.taken){ctx.font='24px Arial';ctx.fillText('💰',m.x,m.y)}});
cars.forEach(c=>{if(!c.taken){ctx.fillStyle=c.color;ctx.fillRect(c.x,c.y,34,20);ctx.font='12px Arial';ctx.fillText('🚗',c.x+5,c.y+16)}});
people.forEach(p=>{ctx.font='24px Arial';ctx.fillText(p.emoji,p.x,p.y)});
police.forEach(p=>{ctx.font='22px Arial';ctx.fillText('🚔',p.x,p.y)});
if(player.inCar){ctx.fillStyle='#00ff88';ctx.fillRect(player.x,player.y,36,22);ctx.font='14px Arial';ctx.fillText('🚗',player.x+6,player.y+17)}else{ctx.font='26px Arial';ctx.fillText(myChar,player.x,player.y+20)}
}
function move(dir){
if(gameOver)return;var s=player.inCar?8:6;
if(dir==='up')player.y-=s;if(dir==='down')player.y+=s;if(dir==='left')player.x-=s;if(dir==='right')player.x+=s;
if(player.x<0)player.x=0;if(player.x>330)player.x=330;if(player.y<0)player.y=0;if(player.y>400)player.y=400;
moneyBag.forEach(m=>{if(!m.taken&&Math.abs(player.x-m.x)<30&&Math.abs(player.y-m.y)<30){m.taken=true;money+=100;picked++;wanted=Math.max(0,wanted-1);document.getElementById('money').innerText=money;document.getElementById('wanted').innerText=wanted;document.getElementById('msg').innerText='💰 '+myName+' pick $100! Total $'+money;document.getElementById('rpChat').innerText='People: "Wow! '+myName+' don pick money! E sabi this city!"';if(picked>=3)document.getElementById('missionText').innerText='You don pick 3 bags! Now reach $500 to become LEGEND of Legend City!';if(money>=500){document.getElementById('msg').innerText='🏆 '+myName+' YOU ARE NOW LEGEND OF LEGEND CITY!';document.getElementById('storyText').innerText=myName+' don become LEGEND! From $0 to $'+money+' as a '+myJob+'. Everybody for Legend City dey call your name!';alert('🏆 YOU WIN! '+myName+' is now LEGEND of Legend City!');gameOver=true;}}});
police.forEach(p=>{
if(wanted>0){if(p.x<player.x)p.x+=p.speed;if(p.x>player.x)p.x-=p.speed;if(p.y<player.y)p.y+=p.speed;if(p.y>player.y)p.y-=p.speed;}
if(Math.abs(player.x-p.x)<26&&Math.abs(player.y-p.y)<26){wanted++;document.getElementById('wanted').innerText=wanted;document.getElementById('msg').innerText='🚔 Police catch '+myName+'! Wanted '+wanted+' stars! Run!';player.x=Math.random()*300;player.y=350;if(wanted>=5){document.getElementById('msg').innerText='💀 BUSTED! '+myName+' don go jail!';alert('💀 BUSTED! '+myName+' go jail. Start new life!');gameOver=true;}}
});
draw();
}
function action(){
if(!player.inCar){
var near=cars.find(c=>!c.taken&&Math.abs(player.x-c.x)<40&&Math.abs(player.y-c.y)<40);
if(near){player.inCar=true;player.car=near;near.taken=true;player.x=near.x;player.y=near.y;document.getElementById('msg').innerText='🚗 '+myName+' enter car! Drive fast!';document.getElementById('actionBtn').innerText='🚶 EXIT CAR';}else{document.getElementById('msg').innerText='No car near you! Go near a 🚗 car.';alert('Go near a car first!');}
}else{player.inCar=false;if(player.car){player.car.x=player.x;player.car.y=player.y;player.car.taken=false;player.car=null}document.getElementById('msg').innerText=myName+' come out of car.';document.getElementById('actionBtn').innerText='🚗 ENTER CAR';}
draw();
}
function talk(){
var near=people.find(p=>Math.abs(player.x-p.x)<40&&Math.abs(player.y-p.y)<40);
if(near){talks++;document.getElementById('rpChat').innerText=near.emoji+' Person: "'+near.say+'"';document.getElementById('msg').innerText='💬 You talk to person. Dem like you!';money+=10;document.getElementById('money').innerText=money;}
else{document.getElementById('rpChat').innerText='No person near you. Go near 👨👩 person and tap TALK again.';document.getElementById('msg').innerText='Go near a person to talk!';}
}
function doJob(){
if(myJob==='GANGSTER'){money+=50;wanted++;document.getElementById('msg').innerText='🦹 You do gangster work! +$50 but Police dey look you! Wanted +1';}
else if(myJob==='TAXI DRIVER'){money+=50;document.getElementById('msg').innerText='🚕 You carry passenger! +$50. Passenger say "Thank you '+myName+'! You be best driver!"';}
else if(myJob==='POLICE'){money+=50;wanted=Math.max(0,wanted-1);document.getElementById('msg').innerText='👮 You catch criminal! +$50. City dey safe because of you! Wanted -1';}
else{money+=70;document.getElementById('msg').innerText='💼 You close big business deal! +$70. Your shop dey grow!';}
document.getElementById('money').innerText=money;document.getElementById('wanted').innerText=wanted;
document.getElementById('rpChat').innerText='People: "'+myName+' the '+myJob+' dey work hard o!"';
if(money>=500&&!gameOver){alert('🏆 YOU WIN! '+myName+' is LEGEND!');gameOver=true;}
}
function resetGame(){player={x:180,y:350,inCar:false,car:null};moneyBag.forEach(m=>m.taken=false);cars.forEach(c=>c.taken=false);money=0;wanted=0;picked=0;gameOver=false;document.getElementById('money').innerText='0';document.getElementById('wanted').innerText='0';document.getElementById('msg').innerText='New Life! '+myName+' start again.';document.getElementById('gameArea').style.display='none';document.getElementById('charSelect').style.display='block';draw();}
document.addEventListener('keydown',e=>{if(e.key==='ArrowUp')move('up');if(e.key==='ArrowDown')move('down');if(e.key==='ArrowLeft')move('left');if(e.key==='ArrowRight')move('right');if(e.key==='Enter')action();});
draw();
</script>
</body>
</html>